generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Medicament {
  id         Int      @id @default(autoincrement())
  nom        String
  quantite   Int
  prix       Float
  expiration String
  createdAt  DateTime @default(now())
}